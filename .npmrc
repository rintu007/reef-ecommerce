# Expo/Metro's bundler doesn't handle pnpm's default symlinked, strictly-
# isolated node_modules well — nested transitive deps (expo-modules-core,
# @expo/metro-runtime, etc.) end up unresolvable from apps/mobile even with
# Metro's watchFolders/nodeModulesPaths configured for the monorepo. Hoisted
# linking is Expo's own documented fix for pnpm monorepos: it flattens
# node_modules similarly to npm/yarn classic, which Metro (and webpack, for
# apps/web) both handle natively.
node-linker=hoisted
