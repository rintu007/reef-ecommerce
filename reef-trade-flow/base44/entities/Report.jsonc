{
  "name": "Report",
  "type": "object",
  "properties": {
    "report_type": {
      "type": "string",
      "enum": [
        "listing",
        "seller"
      ]
    },
    "listing_id": {
      "type": "string"
    },
    "reported_email": {
      "type": "string"
    },
    "reporter_email": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "details": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed",
        "resolved",
        "dismissed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "report_type",
    "reporter_email",
    "reason"
  ]
}